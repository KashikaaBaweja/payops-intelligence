# Copy to .env and fill in values. Never commit .env.

PAYOPS_ENVIRONMENT=local
PAYOPS_LOG_LEVEL=INFO

# sqlite (local) or postgresql+psycopg://USER:PASSWORD@localhost:5432/payops
PAYOPS_DATABASE_URL=sqlite:///./data/local/payops.db

# API
PAYOPS_API_HOST=0.0.0.0
PAYOPS_API_PORT=8000
PAYOPS_CORS_ORIGINS=http://localhost:3000

# Structured JSON logs (one object per line)
PAYOPS_JSON_LOGS=true

# Reserved for later phases. Leave empty in local development.
PAYOPS_LLM_PROVIDER=demo
PAYOPS_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# RAG (Phase 3). `memory` is the default for tests/CI. Use `pgvector` with Postgres.
PAYOPS_EMBEDDING_DIM=128
PAYOPS_VECTOR_BACKEND=memory
PAYOPS_CORPUS_DIR=docs/corpus

# Graph (Phase 7)
PAYOPS_MAX_ITERATIONS=3
PAYOPS_GRAPH_TIMEOUT_SECONDS=30
