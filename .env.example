# Copy to .env and fill in values. Never commit .env.

# sqlite (default) or postgresql+psycopg://user:pass@localhost:5432/payops
PAYOPS_DATABASE_URL=sqlite:///./data/local/payops.db

# openai | anthropic | demo
# demo mode runs the full graph without an API key (deterministic, tool-grounded).
PAYOPS_LLM_PROVIDER=demo
PAYOPS_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# RAG
PAYOPS_VECTOR_DIR=./data/local/chroma
PAYOPS_EMBEDDING_PROVIDER=lexical

# Graph
PAYOPS_MAX_ITERATIONS=3
PAYOPS_MAX_CRITIC_REVISIONS=1

# API
PAYOPS_API_HOST=0.0.0.0
PAYOPS_API_PORT=8000
PAYOPS_CORS_ORIGINS=http://localhost:3000
