FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

COPY pyproject.toml README.md alembic.ini ./
COPY packages ./packages
COPY apps ./apps
COPY alembic ./alembic
COPY docs ./docs
COPY scripts ./scripts

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir ".[postgres]" \
    && chmod +x /app/scripts/entrypoint.sh \
    && useradd --create-home --uid 10001 payops \
    && chown -R payops:payops /app

USER payops

ENV PAYOPS_ENVIRONMENT=production \
    PAYOPS_LOG_LEVEL=INFO \
    PAYOPS_API_HOST=0.0.0.0 \
    PAYOPS_API_PORT=8000 \
    PAYOPS_JSON_LOGS=true \
    PAYOPS_VECTOR_BACKEND=memory \
    PAYOPS_CORPUS_DIR=docs/corpus

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=45s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready', timeout=4)"

ENTRYPOINT ["/app/scripts/entrypoint.sh"]
